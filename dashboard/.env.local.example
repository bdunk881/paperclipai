# Dashboard auth configuration
# Copy this file to .env.local and fill in the Supabase project values for the environment.
# Use the autoflow-dev project for local work — never production credentials here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Auth → URL configuration (same project) must allow:
#   http://localhost:5173/auth/callback
#   http://localhost:5173/reset-password
# Backend API also needs SUPABASE_URL set to the same project (see root .env.example).

# Magic links complete on the API (cross-device). Allow these redirect URLs in Supabase Auth:
#   http://localhost:3000/api/auth/email/callback
#   http://localhost:5173/api/auth/email/callback   (Vite proxy — preferred for local cookies)
#   https://api.helloautoflow.com/api/auth/email/callback
#   https://staging-api.helloautoflow.com/api/auth/email/callback
#   https://dev-api.helloautoflow.com/api/auth/email/callback
# Keep SPA OAuth callbacks: .../auth/callback and .../reset-password
# See docs/auth/supabase-passwordless.md
