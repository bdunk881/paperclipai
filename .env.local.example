# Local-only secrets for docker-compose development.
# Copy to .env.local and fill in real values.

# App signing/encryption secret used by backend.
SECRET_KEY=replace-with-a-long-random-secret

# Postgres password for local container boot.
POSTGRES_PASSWORD=replace-with-a-strong-password

# Supabase Auth — must match dashboard VITE_SUPABASE_URL (autoflow-dev locally).
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key (server-side only). Optional locally; set it to exercise the
# admin console / passkey session minting. REQUIRED in production.
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte master key (64 hex chars) for the company-secret / MCP-auth AES
# envelope. Optional locally (secret-vault features no-op without it); REQUIRED
# in production. Generate: `openssl rand -hex 32`.
CONTROL_PLANE_SECRET_KEY=
# MFA/WebAuthn: localhost defaults work out of the box. Override only when
# testing passkeys against a non-localhost origin (see .env.example for the rules).
# MFA_RP_ID=
# MFA_RP_NAME=
# MFA_ORIGIN=

# Optional: local DB/Redis connection overrides if needed.
DATABASE_URL=postgresql://autoflow:${POSTGRES_PASSWORD}@postgres:5432/autoflow
REDIS_URL=redis://redis:6379

# Sentry Node backend DSN (optional locally — leave blank to disable)
SENTRY_DSN=

# In-memory store fallback (HEL-80, double-locked production safety).
# Set to "true" alongside NODE_ENV=development/test to allow stores to fall
# back to process-local storage when DATABASE_URL is unreachable. Production
# deploys must NEVER set this — bootstrap.ts will refuse to start if Postgres
# is configured but unreachable while NODE_ENV=production.
AUTOFLOW_ALLOW_INMEMORY=true

# Object storage (HEL-352). Local dev uses the in-memory adapter by default
# (STORAGE_PROVIDER unset + AUTOFLOW_ALLOW_INMEMORY=true above). To exercise the
# real S3 code path against LocalStack/MinIO, uncomment and adjust:
# STORAGE_PROVIDER=s3
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=autoflow-local
# STORAGE_S3_ACCESS_KEY_ID=test
# STORAGE_S3_SECRET_ACCESS_KEY=test
# STORAGE_S3_ENDPOINT=http://localhost:4566
