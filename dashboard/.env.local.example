# Dashboard auth configuration
# Copy this file to .env.local and fill in the Supabase project values for the environment.
# Use the autoflow-dev project for local work — never production credentials here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Auth → URL configuration (same project) must allow:
#   http://localhost:5173/auth/callback
#   http://localhost:5173/reset-password
# Backend API also needs SUPABASE_URL set to the same project (see root .env.example).
