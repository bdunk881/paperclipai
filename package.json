{
  "name": "autoflow",
  "version": "0.1.0",
  "description": "AutoFlow — AI-powered workflow automation SaaS",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "infisical run --env=dev -- ts-node src/index.ts",
    "dev:no-secrets": "ts-node src/index.ts",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:coverage": "jest --config jest.config.cjs --coverage --runInBand --forceExit",
    "test:connectors:provider": "jest --config jest.config.cjs --runInBand src/integrations/provider-facing/tier1ProviderFacing.test.ts",
    "test:templates": "jest --config jest.config.cjs --runInBand src/templates",
    "test:api": "jest --config jest.config.cjs --runInBand src/api",
    "test:engine": "jest --config jest.config.cjs --runInBand src/engine",
    "validate:required-checks": "node scripts/validate-required-checks.js",
    "health-report": "ts-node src/integrations/apollo-attio/health-metrics.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "infisical run --env=dev -- ts-node src/worker.ts",
    "skills:import": "ts-node --transpile-only scripts/import-skills.ts",
    "storage:apply-lifecycle": "ts-node --transpile-only src/storage/applyBucketLifecycle.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@anthropic-ai/sdk": "^0.94.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1034.0",
    "@aws-sdk/client-s3": "^3.1059.0",
    "@aws-sdk/client-sesv2": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1059.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^2.2.1",
    "@nicokaiser/passport-apple": "^3.3.0",
    "@openai/agents": "^0.11.5",
    "@sentry/node": "^10.55.0",
    "@sentry/profiling-node": "^10.55.0",
    "@simplewebauthn/server": "^11.0.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.106.1",
    "@types/multer": "^2.1.0",
    "bullmq": "^5.76.8",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jose": "^5.9.6",
    "jsep": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "multer": "^2.1.1",
    "openai": "^6.33.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "stripe": "^21.0.1",
    "ulid": "^2.4.0",
    "uuid": "^11.1.1",
    "ws": "^8.18.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.5",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dashboard/",
      "/\\.worktrees/"
    ],
    "collectCoverageFrom": [
      "src/app.ts",
      "src/auth/**/*.ts",
      "src/billing/**/*.ts",
      "src/engine/**/*.ts",
      "src/llmConfig/**/*.ts",
      "src/mcp/**/*.ts",
      "src/memory/**/*.ts",
      "src/templates/**/*.ts",
      "!src/index.ts",
      "!src/test-factories/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60,
        "functions": 60,
        "branches": 60,
        "statements": 60
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "forceExit": true
  }
}
