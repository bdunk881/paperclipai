# Landing site env (consumed via process.env in server loaders, then forwarded
# to the client via useLoaderData). The landing app does NOT configure Vite to
# inline VITE_* env vars — server-side process.env is the canonical source.

# Backend base URL used by buildLandingApiUrl().
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical landing origin used for SEO + checkout redirects.
NEXT_PUBLIC_BASE_URL=https://helloautoflow.com

# Plausible analytics domain (optional).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Logo.dev publishable key (pk_…) for integration logos on the landing page.
# Build also accepts LOGO_DEV_PUBLISHABLE_KEY or VITE_LOGO_DEV_PUBLISHABLE_KEY.
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=

# Supabase password sign-up flow on /signup.
# Use the autoflow-dev Supabase project for local work — never production keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origin the signup confirmation email redirects to. Defaults to
# https://app.helloautoflow.com when unset. Make sure this origin's
# /auth/confirm and /reset-password are listed in the Supabase project's
# Auth → URL configuration → Redirect URLs.
NEXT_PUBLIC_DASHBOARD_ORIGIN=

# Sanity (blog CMS).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
