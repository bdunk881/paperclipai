# Dashboard auth configuration
# Copy this file to .env.local and fill in the Supabase project values for the environment.
# Use the autoflow-dev project for local work — never production credentials here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional — company/integration logos via logo.dev (https://logo.dev)
VITE_LOGO_DEV_PUBLISHABLE_KEY=

# Optional — HEL-311 spike: enable Supabase's experimental native passkey
# buttons (login "Sign in with passkey" + Security settings "Register
# Supabase passkey"). Dev-only; leave unset in prod. Any value except
# "0"/"false"/"" turns it on. Requires Passkeys enabled in the Supabase
# dashboard (Auth → Passkeys) for the same project.
VITE_AUTOFLOW_SUPABASE_PASSKEYS=

# Supabase Auth → URL configuration (same project) must allow:
#   http://localhost:5173/auth/callback
#   http://localhost:5173/auth/confirm
#   http://localhost:5173/reset-password
# Backend API also needs SUPABASE_URL set to the same project (see root .env.example).
