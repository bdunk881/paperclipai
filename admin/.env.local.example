# Local admin console — copy to admin/.env.local
# Use autoflow-dev Supabase credentials (same as dashboard/.env.local).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave empty: Vite proxies /api to http://localhost:3000 (see admin/vite.config.ts).
VITE_API_BASE_URL=

# Customer dashboard origin for impersonation links during local dev.
VITE_DASHBOARD_ORIGIN=http://localhost:5173
