# Browser origins allowed to call the backend API with CORS credentials.
# Include the dashboard dev server when testing locally, e.g. http://localhost:5173
ALLOWED_ORIGINS=

# Supabase Auth (JWT verification for dashboard Bearer tokens)
# REQUIRED in production. Must match the same project as dashboard
# VITE_SUPABASE_URL (use autoflow-dev locally). Unset → /api routes that verify
# JWTs return 503 (the boot-time check in src/config/requiredSecrets.ts warns in
# dev and refuses to start in production).
SUPABASE_URL=
# Service-role key (bypasses RLS). REQUIRED in production. Gates the admin
# console, passkey/session minting, and password reset. Unset → admin console
# 500s and passkey login 503s. Keep server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional; defaults to "authenticated"
SUPABASE_JWT_AUDIENCES=
# Required by the /api/auth/{sign-up,sign-in,sign-out,forgot-password}
# routes (cookie-session channel via @supabase/ssr). When unset, those
# routes return 503 — the existing JWT-bearer middleware keeps working.
SUPABASE_PUBLISHABLE_KEY=
# Origin used for emailRedirectTo / resetPasswordForEmail redirects from
# the backend cookie-session routes. Defaults to https://app.helloautoflow.com.
DASHBOARD_ORIGIN=

# Native auth CORS proxy for SPA sign-up / sign-in flows when the upstream
# identity provider does not send browser-safe CORS headers.
AUTH_NATIVE_AUTH_PROXY_BASE_URL=
# Optional origin allowlist override. Falls back to ALLOWED_ORIGINS when unset.
AUTH_NATIVE_AUTH_PROXY_ALLOWED_ORIGINS=
# Optional tighter rate limit for unauthenticated native-auth proxy calls.
AUTH_NATIVE_AUTH_PROXY_RATE_LIMIT_MAX=20
AUTH_NATIVE_AUTH_PROXY_RATE_LIMIT_WINDOW_MS=60000

# Stripe — billing / checkout
# Test-mode secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Stripe connector (OAuth / Connect) for Tier 1 rollout verification
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
STRIPE_REDIRECT_URI=
# Optional; defaults to "read_write"
STRIPE_OAUTH_SCOPE=
# Optional override; defaults to https://connect.stripe.com/oauth/authorize
STRIPE_OAUTH_AUTHORIZE_URL=
# Optional override; defaults to https://connect.stripe.com/oauth/token
STRIPE_OAUTH_TOKEN_URL=
# Stripe connector webhook verification secret
STRIPE_CONNECT_WEBHOOK_SECRET=
# Price IDs for recurring monthly plans (test mode)
STRIPE_FLOW_PRICE_ID=price_1TKPReLdsQqpbPtjXEIxgmvy
STRIPE_AUTOMATE_PRICE_ID=price_1TKPRmLdsQqpbPtjGdfkU3S7
STRIPE_SCALE_PRICE_ID=price_1TKPRmLdsQqpbPtjQJMYlOwN
# Webhook signing secret from Stripe dashboard
STRIPE_WEBHOOK_SECRET=

# Landing app contract
# Public backend base URL used by the static landing site.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Canonical landing origin used for checkout success and cancel redirects when
# the request origin is unavailable (for example CLI verification).
LANDING_BASE_URL=http://localhost:3001
# Zapier or equivalent automation webhooks for landing capture forms.
ZAPIER_WEBHOOK_URL=
ZAPIER_BETA_SIGNUP_WEBHOOK_URL=
ZAPIER_WAITLIST_SIGNUP_WEBHOOK_URL=
# Paperclip issue creation for paid signup follow-up tasks triggered by Stripe webhooks.
PAPERCLIP_API_URL=
PAPERCLIP_WEBHOOK_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_CSM_AGENT_ID=
PAPERCLIP_ONBOARDING_GOAL_ID=

# Logo.dev — company/integration logos (dashboard reads publishable key at build time)
LOGO_DEV_PUBLISHABLE_KEY=
# Secret key (sk_…) for server-side Brand/Describe API — not exposed to the browser
LOGO_DEV_API_SECRET_KEY=

# Connector credentials encryption key (used by Slack/Shopify/DocuSign/Linear/PostHog connectors)
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=

# Control-plane secret key — 32-byte master key (64 hex chars) for the
# AES-256-GCM envelope that encrypts provisioned company secrets and MCP server
# auth headers at rest (src/controlPlane/secretEncryption.ts). REQUIRED in
# production. Unset → any company-secret read/write throws. Optional extras:
#   CONTROL_PLANE_SECRET_KEY_VERSION   active key version (default 1)
#   CONTROL_PLANE_SECRET_KEYS          comma-separated "version:hexkey" for rotation
CONTROL_PLANE_SECRET_KEY=
# CONTROL_PLANE_SECRET_KEY_VERSION=1
# CONTROL_PLANE_SECRET_KEYS=

# Slack connector
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# Optional; defaults to channels:read,chat:write,groups:read,channels:history,groups:history
SLACK_SCOPES=
SLACK_SIGNING_SECRET=

# Comms gateway — Telnyx (HEL-614 outbound SMS, HEL-613 inbound webhooks)
# TELNYX_API_KEY + TELNYX_SMS_FROM (or TELNYX_MESSAGING_PROFILE_ID) drive outbound SMS.
# TELNYX_WEBHOOK_PUBLIC_KEY is the base64 Ed25519 key from the Telnyx portal; the
# inbound route (/api/webhooks/comms/telnyx) returns 403 until it is set. All
# optional — leave blank to disable managed SMS + inbound delivery/reply events.
TELNYX_API_KEY=
TELNYX_SMS_FROM=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_PUBLIC_KEY=

# HubSpot connector
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
# Optional; defaults to contact/company/deal read+write scopes
HUBSPOT_SCOPES=
HUBSPOT_WEBHOOK_SECRET=

# Gmail connector
GMAIL_REDIRECT_URI=
# Optional; defaults to Gmail readonly/send/labels/modify scopes
GMAIL_SCOPES=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Linear connector
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=
# Optional; defaults to "read,write"
LINEAR_SCOPES=
LINEAR_WEBHOOK_SECRET=

# Sentry connector
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=
SENTRY_REDIRECT_URI=
# Optional; defaults to "org:read project:read event:read"
SENTRY_SCOPES=
SENTRY_WEBHOOK_SECRET=

# Microsoft Teams connector
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_REDIRECT_URI=
# Optional; defaults to "openid profile offline_access User.Read Chat.Read ChannelMessage.Read.All"
TEAMS_SCOPES=
# Optional; defaults to "common"
TEAMS_TENANT_ID=
TEAMS_WEBHOOK_CLIENT_STATE=

# PostHog connector
POSTHOG_CLIENT_ID=
POSTHOG_CLIENT_SECRET=
POSTHOG_REDIRECT_URI=
# Optional; defaults to "projects:read feature_flags:read events:write"
POSTHOG_SCOPES=
# Optional; defaults to "https://app.posthog.com/oauth"
POSTHOG_OAUTH_BASE_URL=
# Optional; defaults to "https://app.posthog.com"
POSTHOG_API_BASE_URL=
# Optional; defaults to "https://us.i.posthog.com"
POSTHOG_CAPTURE_BASE_URL=
POSTHOG_WEBHOOK_SECRET=

# Intercom connector
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
INTERCOM_REDIRECT_URI=
# Optional; defaults to "read_conversations read_contacts write_contacts write_conversations"
INTERCOM_SCOPES=
# Optional; defaults to "https://app.intercom.com/oauth"
INTERCOM_OAUTH_AUTHORIZE_URL=
# Optional; defaults to "https://api.intercom.io/auth/eagle"
INTERCOM_OAUTH_TOKEN_BASE_URL=
# Optional; defaults to "https://api.intercom.io"
INTERCOM_API_BASE_URL=
# Optional; defaults to "2.13"
INTERCOM_API_VERSION=
INTERCOM_WEBHOOK_SECRET=

# Apollo connector
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=
APOLLO_REDIRECT_URI=
# Optional; defaults to "read_user_profile"
APOLLO_SCOPES=
# Optional; defaults to "https://app.apollo.io/#/oauth/authorize"
APOLLO_OAUTH_AUTHORIZE_URL=
# Optional; defaults to "https://app.apollo.io/api/v1/oauth/token"
APOLLO_OAUTH_TOKEN_URL=
# Optional; required for Apollo inbound webhook verification flows
APOLLO_WEBHOOK_SECRET=

# DocuSign connector
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_REDIRECT_URI=
# Optional; defaults to "signature extended offline_access"
DOCUSIGN_SCOPES=
# Optional; defaults to "https://account-d.docusign.com/oauth"
DOCUSIGN_OAUTH_BASE_URL=
DOCUSIGN_WEBHOOK_SECRET=

# Composio integration broker (HEL-720). ONE shared AutoFlow-owned Composio
# project (NOT a per-user connector). The broker is inert until
# COMPOSIO_ENABLED=true AND COMPOSIO_API_KEY is set — code logs a boot warning
# and dead-ends cleanly until then.
COMPOSIO_ENABLED=false
COMPOSIO_API_KEY=
# Optional; defaults to the hosted backend (https://backend.composio.dev/api/v3.1).
COMPOSIO_API_BASE_URL=
# Inbound Composio webhook signature secret (per webhook subscription).
COMPOSIO_WEBHOOK_SECRET=

# Optional staging-only QA bypass for run execution/retrieval endpoints.
# Enable only in non-production verification environments and restrict to allowlisted IDs.
QA_AUTH_BYPASS_ENABLED=false
QA_AUTH_BYPASS_USER_IDS=qa-smoke-user

# Social auth for staging bypass flows
# Google OAuth app credentials used by Passport social login in staging.
# `GOOGLE_CLIENT_ID` may also be supplied as a deployment environment variable.
# First release is Google-only; Facebook and Apple can be added later using the same route pattern.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Symmetric signing key for app-issued session JWTs.
APP_JWT_SECRET=
# Google OAuth console settings for staging:
# - Authorized JavaScript origins: https://staging.app.helloautoflow.com
# - Authorized redirect URI: https://staging-api.helloautoflow.com/api/auth/social/google/callback
# Optional override when the default `SOCIAL_AUTH_CALLBACK_BASE_URL/google/callback`
# callback shape does not match the deployed ingress.
GOOGLE_CALLBACK_URL=
# Base callback prefix for social providers, expected staging value:
# https://staging-api.helloautoflow.com/api/auth/social
SOCIAL_AUTH_CALLBACK_BASE_URL=
# Default dashboard target when the caller does not provide an approved redirect_uri:
# https://staging.app.helloautoflow.com
SOCIAL_AUTH_DASHBOARD_URL=
# Optional social redirect allowlist override. Falls back to ALLOWED_ORIGINS when unset.
# Expected staging value: https://staging.app.helloautoflow.com
AUTH_SOCIAL_ALLOWED_REDIRECT_ORIGINS=

# Object storage — Tier A first-party file storage (HEL-352)
# Backend selector: "r2" (Cloudflare R2) or "s3" (AWS S3). Leave unset to use
# the in-memory adapter (development/test only, needs AUTOFLOW_ALLOW_INMEMORY=true).
# NOTE: these are the APP's storage credentials and are intentionally distinct
# from the public CLOUDFLARE_R2_* CDN-bucket creds used by the autoflow-brand repo.
STORAGE_PROVIDER=
# Cloudflare R2 (when STORAGE_PROVIDER=r2)
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_BUCKET=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
# Optional; defaults to https://{STORAGE_R2_ACCOUNT_ID}.r2.cloudflarestorage.com
STORAGE_R2_ENDPOINT=
# AWS S3 (when STORAGE_PROVIDER=s3)
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Optional; set to a LocalStack/MinIO endpoint (e.g. http://localhost:4566) for local testing
STORAGE_S3_ENDPOINT=
# TTL (seconds) for signed download URLs returned by staged exports such as the
# observability CSV export (HEL-357). The immediate download handle only — the
# object's longer-term expiry is the retention-class lifecycle rule (HEL-358).
# Default 900 (15 min).
STORAGE_EXPORT_URL_TTL_SECONDS=

# Observability CSV export (HEL-357): max rows written before the export is
# marked `truncated` (bounds server memory on very large workspaces).
# Default 100000.
OBSERVABILITY_EXPORT_MAX_ROWS=

# MFA / WebAuthn (passkeys) — relying-party config.
# REQUIRED in production for passkeys to work on the real origin. These have
# localhost-friendly defaults (RP_ID "localhost", ORIGIN http://localhost:5173,
# NAME "AutoFlow") so dev works out of the box, but on any non-localhost origin
# WebAuthn fails unless these match the deployed host. The boot-time check
# (src/config/requiredSecrets.ts) WARNS when unset (it does not crash, since the
# defaults keep the app running). Mirror rule: MFA_ORIGIN's host must equal (or
# be a subdomain of) MFA_RP_ID, which is the eTLD+1.
#   e.g. MFA_RP_ID=app.helloautoflow.com
#        MFA_ORIGIN=https://app.helloautoflow.com
MFA_RP_ID=
MFA_RP_NAME=
# Comma-separated list of allowed origins (first is primary).
MFA_ORIGIN=

# Hosted free LLM tier (HEL-420) — shared API key for the Explore "free hosted
# model" path (OpenCode Zen / Big Pickle; src/hostedFreeModels/providers.ts).
# This is an AutoFlow-owned shared key, NOT a per-workspace BYOK key. When set,
# Explore workspaces can generate hiring plans and run LLM steps with no key of
# their own; /hire offers "AutoFlow Free Beta" and /settings/llm-providers shows
# the tier as available/default. When UNSET the free tier is disabled (not a
# crash — BYOK still works): /hire shows "No model connected" and the tier reads
# "not configured". The boot-time check (src/config/requiredSecrets.ts) WARNS in
# every environment when unset. Provision it as a Fly secret per environment:
#   fly secrets set OPENCODE_ZEN_API_KEY=<key> -a autoflow-api-dev
OPENCODE_ZEN_API_KEY=

# Redis — BullMQ run queue + distributed rate limiting.
# Provide ONE of the following groups (checked in this order):
#   1. REDIS_URL              — ioredis connection string (redis://… / rediss://…)
#   2. UPSTASH_REDIS_URL      — ioredis over an Upstash TLS endpoint
#   3. UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN — Upstash REST API pair
#      (the canonical pair the queue uses on Fly; src/engine/queue.ts)
# When NONE is configured the queue and rate limiter fall back to in-process
# state (no cross-instance durability) — fine for local dev, NOT for production.
# The boot-time check WARNS when none of the groups is set.
REDIS_URL=
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
